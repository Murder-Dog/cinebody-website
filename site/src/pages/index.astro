---
import Base from '../layouts/Base.astro';
import homepage from '../fragments/homepage.html?raw';
import meet from '../fragments/homepage-director-meet.html?raw';
import { faqSchema } from '../lib/faq';
// Meet the Director lives in its own fragment, spliced in after the logo strip.
const body = homepage.replace('<!--DIRECTOR_MEET-->', meet);
---
<Base schema={faqSchema(body)} active="home" description="Cinebody is the authentic video production platform for real, verifiable video. Real people film on their phones, Cinebody coaches every filmer and cuts the finished video, and every clip carries a Proof of Capture. Trusted by Nike, Royal Caribbean, and Dell.">
  <Fragment set:html={body} />
</Base>
